# Copy to .env and fill in. .env is git-ignored.

# Required by SEC EDGAR: identify yourself with a name and email.
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional: set ONE key to enable the LLM committee. With no key the app runs in data-only mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=          # GOOGLE_API_KEY also works

# Optional model overrides (defaults shown)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium          # low | medium | high | xhigh | max
# OPENAI_MODEL=gpt-6.1-sol         # gpt-6-astra is the stronger, pricier option
# GEMINI_MODEL=gemini-3.8-flash    # gemini-4-argon is the stronger, pricier option
